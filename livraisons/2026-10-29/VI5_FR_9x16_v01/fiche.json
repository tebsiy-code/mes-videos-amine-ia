{
 "ref": "VI5",
 "langue_source": "es",
 "langue_cible": "fr",
 "voix": {
  "id": "VKPzcGCtlJIYdlQ62JDS",
  "repli_id": "",
  "vitesse_max": 1.07
 },
 "lignes": [
  {
   "id": "L1",
   "texte": "Regarde : le secret pour que les griffes restent courtes toutes seules est connu depuis des années, mais presque personne ne le sait.",
   "debut": 0.06,
   "fin_fenetre": 5.95
  },
  {
   "id": "L2",
   "texte": "C'est pour ça que des millions de chats d'intérieur souffrent de griffes trop longues.",
   "debut": 6.0,
   "fin_fenetre": 9.99
  },
  {
   "id": "L3",
   "texte": "Le carton ? Aucune résistance.",
   "debut": 10.04,
   "fin_fenetre": 12.01
  },
  {
   "id": "L4",
   "texte": "Le plastique ? Il l'évite, ça sent mauvais.",
   "debut": 12.06,
   "fin_fenetre": 14.33
  },
  {
   "id": "L5",
   "texte": "Les griffes longues, ce n'est pas un hasard : c'est une surface qui manque.",
   "debut": 14.38,
   "fin_fenetre": 18.17
  },
  {
   "id": "L6",
   "texte": "Les chats sont faits pour se limer les griffes sur un type de surface bien précis, une surface ferme, comme l'écorce des arbres.",
   "debut": 18.22,
   "fin_fenetre": 23.95
  },
  {
   "id": "L7",
   "texte": "La même résistance que l'écorce d'un arbre.",
   "debut": 24.0,
   "fin_fenetre": 25.75
  },
  {
   "id": "L8",
   "texte": "Sans elle, la couche extérieure morte de sa griffe s'accumule petit à petit.",
   "debut": 25.97,
   "fin_fenetre": 29.21
  },
  {
   "id": "L9",
   "texte": "Les griffes continuent de pousser, finissent par se recourber, s'accrochent, et peuvent même se planter dans ses coussinets.",
   "debut": 29.92,
   "fin_fenetre": 34.79
  },
  {
   "id": "L10",
   "texte": "Et toi, tu ne vois rien, car les chats cachent leur douleur.",
   "debut": 35.13,
   "fin_fenetre": 37.37
  },
  {
   "id": "L11",
   "texte": "C'est là qu'arrive Nidélia.",
   "debut": 37.88,
   "fin_fenetre": 38.67
  },
  {
   "id": "L12",
   "texte": "On ne va pas te dire que c'est un miracle dès le premier jour.",
   "debut": 39.19,
   "fin_fenetre": 41.27
  },
  {
   "id": "L13",
   "texte": "Les chats ont besoin de trois à sept jours environ pour l'adopter, parce qu'ils doivent d'abord y laisser leur propre odeur.",
   "debut": 41.71,
   "fin_fenetre": 46.89
  },
  {
   "id": "L14",
   "texte": "Mais une fois que c'est fait, la corde naturelle fait ce que le synthétique ne peut pas faire.",
   "debut": 46.96,
   "fin_fenetre": 51.17
  },
  {
   "id": "L15",
   "texte": "Elle garde son odeur pour toujours.",
   "debut": 51.22,
   "fin_fenetre": 52.57
  },
  {
   "id": "L16",
   "texte": "Alors même les chats qui ignoraient tous les autres griffoirs reviennent à celui-ci.",
   "debut": 52.9,
   "fin_fenetre": 57.31
  },
  {
   "id": "L17",
   "texte": "Contrairement au carton, Nidélia a exactement la même résistance que l'écorce d'un arbre, assez ferme pour retirer la couche morte de sa griffe à chaque traction.",
   "debut": 57.36,
   "fin_fenetre": 65.49
  },
  {
   "id": "L18",
   "texte": "Il se lime les griffes tout seul, à chaque fois, comme la nature l'a prévu.",
   "debut": 65.54,
   "fin_fenetre": 68.83
  },
  {
   "id": "L19",
   "texte": "Chaque Nidélia est tissé main, avec soin et précision.",
   "debut": 68.88,
   "fin_fenetre": 71.25
  },
  {
   "id": "L20",
   "texte": "Alors, contrairement aux griffoirs bon marché qui cassent, Nidélia dure des années.",
   "debut": 71.53,
   "fin_fenetre": 74.83
  },
  {
   "id": "L21",
   "texte": "Maintenant, tu connais le secret.",
   "debut": 75.37,
   "fin_fenetre": 76.47
  },
  {
   "id": "L22",
   "texte": "Utilise-le.",
   "debut": 77.0,
   "fin_fenetre": 77.25
  },
  {
   "id": "L23",
   "texte": "Nidélia, aujourd'hui à moins 50 %, avec 90 jours sans risque.",
   "debut": 77.9,
   "fin_fenetre": 81.85
  }
 ],
