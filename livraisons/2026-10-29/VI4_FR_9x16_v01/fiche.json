{
 "ref": "VI4",
 "langue_source": "es",
 "langue_cible": "fr",
 "voix": {
  "id": "MF66XIWqB54kiqXZ8fgu",
  "repli_id": "",
  "vitesse_max": 1.07
 },
 "lignes": [
  {
   "id": "L1",
   "texte": "N'achète pas le panier Nidélia si tu n'es pas prêt à perdre ton chat.",
   "debut": 0.06,
   "fin_fenetre": 3.55
  },
  {
   "id": "L2",
   "texte": "On m'a dit qu'il lui limerait les griffes et qu'il le rassurerait.",
   "debut": 3.6,
   "fin_fenetre": 7.19
  },
  {
   "id": "L3",
   "texte": "D'accord, mais personne ne m'avait dit qu'il allait pratiquement vivre dedans.",
   "debut": 7.24,
   "fin_fenetre": 11.21
  },
  {
   "id": "L4",
   "texte": "Ça fait seulement une semaine qu'il le griffe.",
   "debut": 11.26,
   "fin_fenetre": 13.19
  },
  {
   "id": "L5",
   "texte": "Et regarde ses griffes, super saines.",
   "debut": 13.25,
   "fin_fenetre": 15.11
  },
  {
   "id": "L6",
   "texte": "En plus, il a l'air beaucoup plus heureux.",
   "debut": 15.16,
   "fin_fenetre": 16.97
  },
  {
   "id": "L7",
   "texte": "Je comprends pourquoi il adore cette corde naturelle.",
   "debut": 17.02,
   "fin_fenetre": 19.55
  },
  {
   "id": "L8",
   "texte": "Elle a la même densité que l'écorce d'un arbre.",
   "debut": 19.6,
   "fin_fenetre": 21.85
  },
  {
   "id": "L9",
   "texte": "Ni carton, ni sisal synthétique.",
   "debut": 21.93,
   "fin_fenetre": 23.87
  },
  {
   "id": "L10",
   "texte": "L'écorce d'arbre.",
   "debut": 24.08,
   "fin_fenetre": 24.73
  },
  {
   "id": "L11",
   "texte": "Je pensais qu'il allait l'ignorer comme tous les griffoirs.",
   "debut": 25.0,
   "fin_fenetre": 27.65
  },
  {
   "id": "L12",
   "texte": "Mais il en a fait son coin.",
   "debut": 27.7,
   "fin_fenetre": 29.25
  },
  {
   "id": "L13",
   "texte": "On m'a expliqué que la corde absorbe ses phéromones : plus il l'utilise, plus elle sent son odeur.",
   "debut": 29.3,
   "fin_fenetre": 34.71
  },
  {
   "id": "L14",
   "texte": "Je comprends.",
   "debut": 34.76,
   "fin_fenetre": 35.61
  },
  {
   "id": "L15",
   "texte": "Sérieux, c'est son lit, son griffoir et son coin de jeu.",
   "debut": 35.66,
   "fin_fenetre": 39.13
  },
  {
   "id": "L16",
   "texte": "Vous, continuez d'acheter des poteaux en plastique à changer toutes les deux semaines.",
   "debut": 39.18,
   "fin_fenetre": 43.45
  },
  {
   "id": "L17",
   "texte": "Moi, je le regarde se limer les griffes.",
   "debut": 43.5,
   "fin_fenetre": 45.97
  },
  {
   "id": "L18",
   "texte": "Ah, et là il y a une grosse promo, livraison offerte.",
   "debut": 46.02,
   "fin_fenetre": 48.93
  },
  {
   "id": "L19",
   "texte": "Je vous mets le lien en dessous.",
   "debut": 48.98,
   "fin_fenetre": 50.35
  },
  {
   "id": "L20",
   "texte": "Foncez prendre le vôtre avant la prochaine rupture de stock.",
   "debut": 50.53,
   "fin_fenetre": 54.4
  }
 ],
