 "lignes": [
  {
   "id": "S1",
   "texte": "Ma mère dit toujours qu'elle ne veut rien.",
   "debut": 0.06,
   "fin_fenetre": 2.93
  },
  {
   "id": "S2",
   "texte": "Après ce cadeau de Noël, j'ai compris trois choses.",
   "debut": 2.98,
   "fin_fenetre": 6.01
  },
  {
   "id": "S3",
   "texte": "Un, il est vraiment unique.",
   "debut": 6.1,
   "fin_fenetre": 8.11
  },
  {
   "id": "S4",
   "texte": "Oublie les cadeaux qui finissent dans un tiroir.",
   "debut": 8.16,
   "fin_fenetre": 11.03
  },
  {
   "id": "S5",
   "texte": "C'est toute une expérience.",
   "debut": 11.08,
   "fin_fenetre": 13.01
  },
  {
   "id": "S6",
   "texte": "On croit à de vrais sushis en ouvrant la boîte.",
   "debut": 13.06,
   "fin_fenetre": 16.19
  },
  {
   "id": "S7",
   "texte": "Quoi, des chaussettes ?",
   "debut": 16.24,
   "fin_fenetre": 17.87
  },
  {
   "id": "S8",
   "texte": "Deux, pour le prix, c'est incroyablement bien.",
   "debut": 17.92,
   "fin_fenetre": 20.63
  },
  {
   "id": "S9",
   "texte": "Cinq paires de chaussettes, dix sushis et des baguettes dans une seule boîte.",
   "debut": 20.75,
   "fin_fenetre": 25.19
  },
  {
   "id": "S10",
   "texte": "Et on les porte.",
   "debut": 25.48,
   "fin_fenetre": 26.69
  },
  {
   "id": "S11",
   "texte": "Pas un cadeau qui traîne.",
   "debut": 26.75,
   "fin_fenetre": 28.39
  },
  {
   "id": "S12",
   "texte": "Trois, tu fais plaisir.",
   "debut": 28.44,
   "fin_fenetre": 30.75
  },
  {
   "id": "S14",
   "texte": "Maman a dit, mon préféré.",
   "debut": 30.8,
   "fin_fenetre": 32.71
  },
  {
   "id": "S15",
   "texte": "Devine, elle en veut d'autres.",
   "debut": 32.79,
   "fin_fenetre": 34.87
  },
  {
   "id": "S16",
   "texte": "Attends qu'ils prennent un sushi.",
   "debut": 34.92,
   "fin_fenetre": 37.37
  },
  {
   "id": "S17",
   "texte": "Avec ce cadeau, le malin, c'est celui qui offre.",
   "debut": 37.42,
   "fin_fenetre": 40.17
  },
  {
   "id": "S18",
   "texte": "C'est toi qui offres les meilleurs cadeaux.",
   "debut": 40.64,
   "fin_fenetre": 42.73
  },
  {
   "id": "S19",
   "texte": "On demande, tu l'as eu où ?",
   "debut": 42.78,
   "fin_fenetre": 44.55
  },
  {
   "id": "S20",
   "texte": "Va voir sur wunela.com.",
   "debut": 44.6,
   "fin_fenetre": 46.97
  },
  {
   "id": "S21",
   "texte": "Un acheté, un offert.",
   "debut": 47.02,
   "fin_fenetre": 49.29
  }
